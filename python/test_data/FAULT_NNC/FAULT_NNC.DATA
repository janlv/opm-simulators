SOLUTION

-- Enumerated initial state: undersaturated oil (bubble point of RS 1.27 is 4014.7 psia)
-- with mobile water and no gas.
PRESSURE
   72*4800 /
SWAT
   72*0.4 /
SGAS
   72*0.0 /
RS
   72*1.27 /

SUMMARY

FOPR
FWIR

SCHEDULE

WELSPECS
   'PROD'  'G1'  6  4  8400  'OIL' /
   'INJ'   'G1'  1  1  8335  'WATER' /
/

COMPDAT
   'PROD'  6  4  1  3  'OPEN'  1*  1*  0.5 /
   'INJ'   1  1  1  3  'OPEN'  1*  1*  0.5 /
/

WCONPROD
   'PROD'  'OPEN'  'LRAT'  3*  5000  1*  1000 /
/

WCONINJE
   'INJ'  'WATER'  'OPEN'  'RATE'  5000  1*  9000 /
/

TSTEP
   2*1 /

END
